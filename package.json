{
  "name": "claude-studio",
  "displayName": "Claude Studio",
  "description": "Same Claude Code but, a better IDE! The same Claude Code, in a panel you can actually watch. It keeps the Claude Code CLI updated on its own, so you're never behind on models or features. Live progress, diffs you open when you want, one-click permissions, and attach any file, not just images.",
  "version": "0.15.3",
  "publisher": "MrWilson",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "chat",
    "agent",
    "copilot alternative",
    "diff",
    "permissions",
    "attachments",
    "pdf",
    "excel",
    "word",
    "docx",
    "xlsx",
    "csv",
    "zip",
    "video",
    "file upload",
    "macos"
  ],
  "galleryBanner": {
    "color": "#1a1614",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Amplaye/claude-studio.git"
  },
  "homepage": "https://github.com/Amplaye/claude-studio#readme",
  "bugs": {
    "url": "https://github.com/Amplaye/claude-studio/issues"
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:claudeStudio.panel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeStudio",
          "title": "Claude Studio",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "claudeStudio": [
        {
          "type": "webview",
          "id": "claudeStudio.chat",
          "name": "Chat"
        },
        {
          "type": "webview",
          "id": "claudeStudio.context",
          "name": "Context"
        }
      ]
    },
    "icons": {
      "studio-chat": {
        "description": "Ionicons chatbubble-ellipses",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E001"
        }
      },
      "studio-pulse": {
        "description": "Ionicons pulse",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E002"
        }
      },
      "studio-warn": {
        "description": "Ionicons warning",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E003"
        }
      },
      "studio-alert": {
        "description": "Ionicons alert-circle",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E004"
        }
      },
      "studio-layers": {
        "description": "Ionicons layers",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E005"
        }
      },
      "studio-gauge": {
        "description": "Ionicons speedometer",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E006"
        }
      },
      "studio-branch": {
        "description": "Ionicons git-branch",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E007"
        }
      },
      "studio-off": {
        "description": "Ionicons remove-circle",
        "default": {
          "fontPath": "media/ionicons-studio.woff2",
          "fontCharacter": "\\E008"
        }
      }
    },
    "commands": [
      {
        "command": "claudeStudio.show",
        "title": "Claude Studio: Open Chat"
      },
      {
        "command": "claudeStudio.openSidebar",
        "title": "Claude Studio: Open in Sidebar"
      },
      {
        "command": "claudeStudio.openTab",
        "title": "Claude Studio: Open as Tab",
        "icon": "media/open.svg"
      },
      {
        "command": "claudeStudio.openTabBeside",
        "title": "Claude Studio: Open as Tab Beside"
      },
      {
        "command": "claudeStudio.openNewTab",
        "title": "Claude Studio: New Session in a New Tab"
      },
      {
        "command": "claudeStudio.newSession",
        "title": "Claude Studio: Clear This Conversation"
      },
      {
        "command": "claudeStudio.rename",
        "title": "Claude Studio: Rename This Conversation"
      },
      {
        "command": "claudeStudio.interrupt",
        "title": "Claude Studio: Stop"
      },
      {
        "command": "claudeStudio.context.show",
        "title": "Claude Studio: Open Context Panel"
      },
      {
        "command": "claudeStudio.context.refresh",
        "title": "Claude Studio: Refresh Context",
        "icon": "$(studio-pulse)"
      },
      {
        "command": "claudeStudio.context.diagnose",
        "title": "Claude Studio: What the Context Bar Sees"
      },
      {
        "command": "claudeStudio.update",
        "title": "Claude Studio: Check for Updates"
      }
    ],
    "keybindings": [
      {
        "command": "claudeStudio.show",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "claudeStudio.openNewTab",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeStudio.openTab",
          "when": "view == claudeStudio.chat",
          "group": "navigation@1"
        },
        {
          "command": "claudeStudio.context.refresh",
          "when": "view == claudeStudio.context",
          "group": "1_studio"
        },
        {
          "command": "claudeStudio.context.diagnose",
          "when": "view == claudeStudio.context",
          "group": "1_studio"
        }
      ]
    },
    "configuration": {
      "title": "Claude Studio",
      "properties": {
        "claudeStudio.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the claude command (the binary in bin/, or cli.js on older versions). Leave empty for auto-detection."
        },
        "claudeStudio.autoUpdate": {
          "type": "string",
          "enum": [
            "auto",
            "check",
            "off"
          ],
          "enumDescriptions": [
            "Updates the Claude Code CLI on its own, and tells you once it's done.",
            "Just watches: warns you when something new is out, but changes nothing.",
            "Checks nothing. The \"Claude Studio: Check for Updates\" command is still there."
          ],
          "default": "auto",
          "description": "How to stay up to date. The check runs 30 seconds after startup and then every 6 hours. The CLI is what brings in new models: keeping it behind means working with old ones."
        },
        "claudeStudio.updateSourcePath": {
          "type": "string",
          "default": "",
          "description": "For whoever develops Claude Studio: the folder holding its source, rebuilt and reinstalled when a git pull or a new Agent SDK brings something newer. `~` means your home folder. Leave empty — installed from the Marketplace, VS Code keeps the extension updated on its own."
        },
        "claudeStudio.contextLimit": {
          "type": "number",
          "default": 1000000,
          "description": "Total context window in tokens (used to compute the percentage)."
        },
        "claudeStudio.refreshSeconds": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.5,
          "description": "How often the context bar recalculates. It won't go below half a second."
        },
        "claudeStudio.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the session, the context and your account usage in the status bar."
        },
        "claudeStudio.openAsTab": {
          "type": "boolean",
          "default": true,
          "description": "Clicking the icon in the activity bar opens the full-screen tab (just one: if it's already open, it comes back to the front) and closes the sidebar. Turn this off to stay in the sidebar."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node build.mjs && vsce package --no-dependencies -o claude-studio.vsix",
    "release": "node scripts/release.mjs",
    "publish:marketplace": "node scripts/publish-marketplace.mjs claude-studio.vsix",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "tips": "node scripts/build-tips.mjs",
    "preview": "node build.mjs && node scripts/preview.mjs",
    "ui-check": "node build.mjs && node scripts/preview.mjs && node scripts/ui-check.mjs && node scripts/context-check.mjs && node scripts/lang-check.mjs && node scripts/sessions-check.cjs && node scripts/reload-check.cjs && node scripts/tasks-check.cjs && node scripts/tips-check.mjs && node scripts/menu-check.mjs",
    "smoke": "node scripts/smoke-engine.mjs",
    "tasks-live": "node build.mjs && node scripts/tasks-check.cjs --live",
    "data-check": "node build.mjs && node scripts/data-check.cjs",
    "host-check": "node build.mjs && node scripts/host-check.cjs",
    "verify": "npm run typecheck && npm run ui-check && node scripts/data-check.cjs && node scripts/host-check.cjs && node scripts/update-check.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff2": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "ionicons": "^8.1.0",
    "zod": "^4.4.3"
  }
}
